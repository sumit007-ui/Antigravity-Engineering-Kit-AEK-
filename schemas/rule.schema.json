{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AekRule",
  "description": "Schema for AEK engineering rules",
  "type": "object",
  "required": ["id", "name", "description", "scope", "priority", "content"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": ["global", "workspace", "project"]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "content": {
      "type": "string",
      "maxLength": 24000
    }
  }
}
