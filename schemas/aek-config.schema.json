{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AekConfig",
  "description": "Antigravity Engineering Kit (AEK) Configuration Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "general": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "default": "AEK",
          "minLength": 1
        },
        "config_version": {
          "type": "integer",
          "enum": [1]
        },
        "profile": {
          "type": "string",
          "enum": ["light", "engineering", "full"],
          "default": "light"
        }
      },
      "required": ["config_version", "profile"]
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"],
          "default": "info"
        },
        "format": {
          "type": "string",
          "enum": ["text", "json"],
          "default": "text"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "type": "boolean",
          "default": false
        },
        "max_concurrent_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 2
        },
        "default_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "default": 30
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_destructive_operations": {
          "type": "boolean",
          "default": false
        },
        "require_confirmation": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp_enabled": {
          "type": "boolean",
          "default": false
        },
        "prompt_optimization_enabled": {
          "type": "boolean",
          "default": false
        },
        "security_scanning_enabled": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rustc_path": { "type": "string" },
        "cargo_path": { "type": "string" },
        "git_path": { "type": "string" },
        "node_path": { "type": "string" },
        "python_path": { "type": "string" }
      }
    }
  },
  "required": ["general"]
}

