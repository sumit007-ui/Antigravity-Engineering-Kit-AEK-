{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AekSkillMetadata",
  "description": "Schema for AEK agent skill metadata",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "triggers": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

