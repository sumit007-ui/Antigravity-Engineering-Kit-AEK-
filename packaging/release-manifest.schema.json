{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEK Release Manifest Schema",
  "description": "Schema for machine-readable Antigravity Engineering Kit (AEK) release manifests",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "release_channel",
    "timestamp",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$"
    },
    "release_channel": {
      "type": "string",
      "enum": ["stable", "beta", "nightly"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "filename",
          "target_triple",
          "os",
          "arch",
          "size_bytes",
          "sha256",
          "download_url"
        ],
        "properties": {
          "filename": { "type": "string" },
          "target_triple": { "type": "string" },
          "os": { "type": "string", "enum": ["windows", "linux", "macos"] },
          "arch": { "type": "string", "enum": ["x86_64", "aarch64"] },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "download_url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
